{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "3000",
        "--directory",
        "frontend"
      ],
      "port": 3000
    },
    {
      "name": "vinted-mock",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "3311",
        "--directory",
        "tests/vinted-mock"
      ],
      "port": 3311
    },
    {
      "name": "backend",
      "runtimeExecutable": "uvicorn",
      "runtimeArgs": [
        "backend.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8001"
      ],
      "port": 8001
    },
    {
      "name": "onboarding-preview",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "3313",
        "--bind",
        "127.0.0.1",
        "--directory",
        "tests/onboarding-preview"
      ],
      "port": 3313
    }
  ]
}